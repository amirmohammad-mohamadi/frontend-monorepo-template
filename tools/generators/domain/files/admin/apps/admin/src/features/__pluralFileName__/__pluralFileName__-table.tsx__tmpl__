"use client";

import { Button, Input, Skeleton, Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@components";
import { formatDate } from "@utils";
import { PageHeader } from "@/components/page-header";
import { use<%= pluralClassName %>Table } from "./<%= pluralFileName %>-table.hook";

const TEXTS = {
  title: "<%= pluralClassName %>",
  search: "Search",
  columns: { name: "Name", created: "Created" },
  empty: "Nothing here yet.",
  loadError: "The list could not be loaded.",
  retry: "Try again",
  previous: "Previous",
  next: "Next",
};

export function <%= pluralClassName %>Table() {
  const table = use<%= pluralClassName %>Table();
  const list = table.query.data;
  const paginate = list?.getPaginate();

  return (
    <>
      <PageHeader title={TEXTS.title} />
      <Input value={table.search} onChange={(e) => table.setSearch(e.target.value)} placeholder={TEXTS.search} aria-label={TEXTS.search} className="max-w-xs" />
      <div className="rounded-md border">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>{TEXTS.columns.name}</TableHead>
              <TableHead>{TEXTS.columns.created}</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {table.query.isPending ? (
              Array.from({ length: 5 }).map((_, i) => (
                <TableRow key={i}>
                  <TableCell colSpan={2}>
                    <Skeleton className="h-5 w-full" />
                  </TableCell>
                </TableRow>
              ))
            ) : table.query.isError ? (
              <TableRow>
                <TableCell colSpan={2} className="py-10 text-center">
                  <p role="alert">{TEXTS.loadError}</p>
                  <Button variant="outline" size="sm" className="mt-3" onClick={() => table.query.refetch()}>
                    {TEXTS.retry}
                  </Button>
                </TableCell>
              </TableRow>
            ) : !list || list.getItems().length === 0 ? (
              <TableRow>
                <TableCell colSpan={2} className="text-muted-foreground py-10 text-center">
                  {TEXTS.empty}
                </TableCell>
              </TableRow>
            ) : (
              list.getItems().map((item) => (
                <TableRow key={String(item.getId())}>
                  <TableCell className="font-medium">{item.getName()}</TableCell>
                  <TableCell className="text-muted-foreground">{formatDate(item.getCreatedAt(), "en-GB")}</TableCell>
                </TableRow>
              ))
            )}
          </TableBody>
        </Table>
      </div>
      {paginate && paginate.getLastPage() > 1 ? (
        <div className="flex items-center justify-between">
          <Button variant="outline" size="sm" disabled={!paginate.getHasPreviousPage()} onClick={() => table.setPage(table.page - 1)}>
            {TEXTS.previous}
          </Button>
          <Button variant="outline" size="sm" disabled={!paginate.getHasNextPage()} onClick={() => table.setPage(table.page + 1)}>
            {TEXTS.next}
          </Button>
        </div>
      ) : null}
    </>
  );
}
